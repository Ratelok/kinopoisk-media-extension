{
  "manifest_version": 3,
  "name": "Kinopoisk MediaStack (Jellyseerr & Jellyfin)",
  "version": "1.0.0",
  "description": "Интеграция Кинопоиска с Jellyseerr и Jellyfin: скачивание фильмов и сериалов в один клик и быстрый переход к просмотру.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.kinopoisk.ru/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background/jellyseerr-api.js",
      "background/jellyfin-api.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kinopoisk.ru/film/*",
        "*://*.kinopoisk.ru/series/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kinopoisk MediaStack",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kinopoisk-mediastack@ratelok.xyz",
      "strict_min_version": "109.0"
    }
  }
}
